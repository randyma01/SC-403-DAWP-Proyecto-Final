# ==============================================================================
# PLANTILLA DE SECRETOS - CanchaLibre
# ------------------------------------------------------------------------------
# 1. Copie este archivo como:   CanchaLibre/secrets.properties
# 2. Reemplace los valores <...> con los reales (los comparte el equipo por un canal privado).
# 3. NUNCA suba secrets.properties a GitHub: ya esta en .gitignore.
#
# En Render (produccion) estas mismas claves se definen como variables de entorno
# en  Dashboard > Environment, y el JSON de Firebase como "Secret File".
# ==============================================================================

# ---------- Base de datos MySQL en Aiven ----------
# Aiven Console > su servicio MySQL > Overview > "Service URI" / Connection information
DB_URL=jdbc:mysql://<host>.aivencloud.com:<puerto>/defaultdb?sslMode=REQUIRED
DB_USERNAME=avnadmin
DB_PASSWORD=<password-de-aiven>

# ---------- Firebase Storage (imagenes y comprobantes) ----------
# firebase = usa Firebase Storage | local = guarda en ./uploads (solo desarrollo)
STORAGE_PROVIDER=firebase
FIREBASE_BUCKET_NAME=<proyecto>.firebasestorage.app
FIREBASE_STORAGE_PATH=cancha-libre
# Carpeta (dentro de src/main/resources) y nombre del JSON de la cuenta de servicio
FIREBASE_JSON_PATH=firebase
FIREBASE_JSON_FILE=<proyecto>-firebase-adminsdk-xxxxx-xxxxxxxxxx.json
